#!/usr/bin/env python3
"""Nimbus OS desktop shell.

Shows the Nimbus desktop full screen and gives it a small, fixed set of
abilities on the real machine (power, system information, time zone).
The page talks to this process through a WebKit script message handler
named "nimbus"; replies come back through window.__nimbusNative.

Under nimbus-wm (the window manager, which starts this program) it also
relays between the page and the window manager over NIMBUS_WM_FD, so real
programs' windows (Google Chrome, or anything started from Terminal) show
on the desktop, and it starts and installs those programs.
"""
import base64
import configparser
import glob
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import threading
import time

import gi

sys.path.insert(0, os.environ.get("NIMBUS_LIB_DIR", "/usr/lib/nimbus"))
import nimbus_net  # noqa: E402
import nimbus_sys  # noqa: E402
import nimbus_term  # noqa: E402

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gdk, GLib, Gtk, WebKit2  # noqa: E402

VERSION = "0.1"
BUILD = {}
try:
    with open("/usr/share/nimbus/build-info.json") as _f:
        BUILD = json.load(_f)
except (OSError, ValueError):
    pass
STORAGE_LABEL = "writable"  # keep in step with /usr/lib/nimbus/nimbus-storage
# Calls that are quick and touch state shared with the main loop run on the main thread.
MAIN_THREAD = {"termOpen", "termInput", "termResize", "termClose", "log", "wm", "wmReady"}
SHELL_DIR = os.environ.get("NIMBUS_SHELL_DIR", "/usr/share/nimbus/shell")
DATA_DIR = os.path.join(GLib.get_user_data_dir(), "nimbus")
CACHE_DIR = os.path.join(GLib.get_user_cache_dir(), "nimbus")
SOFTWARE = os.environ.get("NIMBUS_SOFTWARE") == "1" or not glob.glob("/dev/dri/renderD*")
# Start with "nimbus.debug" on the kernel command line to log keyboard and focus events.
DEBUG = bool(os.environ.get("NIMBUS_DEBUG")) or "nimbus.debug" in open("/proc/cmdline").read().split()
CHROME = "/usr/bin/google-chrome-stable"
CHROME_ICONS = ("/usr/share/icons/hicolor/256x256/apps/google-chrome.png", "/opt/google/chrome/product_logo_256.png",
                "/usr/share/icons/hicolor/128x128/apps/google-chrome.png")
# The window manager's desktop socket is passed in by nimbus-wm; programs must not inherit it.
PRIVATE_ENV = ("NIMBUS_WM_FD", "WAYLAND_SOCKET")
STATES = {"normal": 0, "max": 1, "snap": 2, "full": 3}
VENDORS = {"0x8086": "Intel", "0x1002": "AMD", "0x10de": "NVIDIA", "0x1234": "QEMU", "0x1af4": "Virtio",
           "0x15ad": "VMware", "0x80ee": "VirtualBox", "0x1414": "Microsoft Hyper-V", "0x5143": "Qualcomm"}


def read(path, default=""):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read().strip()
    except OSError:
        return default


def os_release(path):
    out = {}
    for line in read(path).splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            out[k] = v.strip().strip('"')
    return out


def cpu_model():
    for line in read("/proc/cpuinfo").splitlines():
        if line.lower().startswith("model name"):
            return " ".join(line.split(":", 1)[1].split())
    return platform_machine()


def platform_machine():
    return os.uname().machine


def mem_total():
    for line in read("/proc/meminfo").splitlines():
        if line.startswith("MemTotal:"):
            return int(line.split()[1]) * 1024
    return 0


def gpus():
    out = []
    for card in sorted(glob.glob("/sys/class/drm/card[0-9]")):
        dev = os.path.join(card, "device")
        vendor = read(os.path.join(dev, "vendor"))
        driver = os.path.basename(os.path.realpath(os.path.join(dev, "driver"))) if os.path.exists(os.path.join(dev, "driver")) else ""
        name = VENDORS.get(vendor, "Display adapter")
        if driver == "simple-framebuffer" or driver == "simpledrm":
            name = "Basic display"
        out.append({"name": name, "driver": driver})
    return out


def battery():
    for ps in sorted(glob.glob("/sys/class/power_supply/*")):
        if read(os.path.join(ps, "type")) == "Battery" and read(os.path.join(ps, "scope"), "System") != "Device":
            cap = read(os.path.join(ps, "capacity"))
            if cap.isdigit():
                status = read(os.path.join(ps, "status"))
                return {"percent": int(cap), "charging": status in ("Charging", "Full")}
    return None


def cmdline_value(key):
    """The value of key=value on the kernel command line, or ""."""
    for part in read("/proc/cmdline").split():
        if part.startswith(key + "="):
            return part.split("=", 1)[1]
    return ""


def persistent():
    """True when the live session keeps its changes: started with "persistent" and the storage area is
    mounted (casper mounts it before the system starts, out of sight; /proc/fs/ext4 still lists it)."""
    args = read("/proc/cmdline").split()
    if "persistent" not in args or "nopersistent" in args:
        return False
    try:
        out = subprocess.run(["lsblk", "-rn", "-o", "NAME,LABEL"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return False
    return any(len(f) == 2 and f[1] == STORAGE_LABEL and os.path.isdir("/proc/fs/ext4/" + f[0])
               for f in (line.split() for line in out.splitlines()))


def storage(*args):
    """Run the storage helper as root (allowed by /etc/sudoers.d/nimbus-storage) and return its answer."""
    r = subprocess.run(["sudo", "-n", "/usr/lib/nimbus/nimbus-storage", *args], capture_output=True, text=True, timeout=240)
    lines = r.stdout.strip().splitlines()
    try:
        data = json.loads(lines[-1]) if lines else {}
    except ValueError:
        data = {}
    if not data.get("ok"):
        raise RuntimeError(data.get("error") or (r.stderr.strip().splitlines() or ["The storage helper failed"])[-1])
    return data


def is_live():
    cmd = read("/proc/cmdline")
    return "boot=casper" in cmd or os.path.isdir("/run/casper") or os.path.isdir("/cdrom/casper")


def timezone():
    target = os.path.realpath("/etc/localtime")
    tz = target.split("/zoneinfo/", 1)[1] if "/zoneinfo/" in target else (read("/etc/timezone") or "UTC")
    return "UTC" if tz in ("Etc/UTC", "Etc/Universal", "Universal", "Zulu", "Etc/Zulu", "UCT", "Etc/UCT") else tz


def timezones():
    try:
        import zoneinfo
        zones = zoneinfo.available_timezones()
    except Exception:
        zones = set()
    keep = [z for z in zones if "/" in z and not z.startswith(("Etc/", "SystemV/", "posix/", "right/"))]
    return sorted(keep) + ["UTC"]


def info():
    base = os_release("/usr/lib/os-release.base") or os_release("/etc/os-release")
    usage = shutil.disk_usage("/")
    dmi = " ".join(x for x in (read("/sys/class/dmi/id/sys_vendor"), read("/sys/class/dmi/id/product_name")) if x and x.lower() not in ("to be filled by o.e.m.", "system product name", "default string"))
    return {
        "version": VERSION,
        "base": base.get("PRETTY_NAME", "Linux"),
        "kernel": os.uname().release,
        "cpu": cpu_model(),
        "cores": os.cpu_count() or 1,
        "memory": mem_total(),
        "disk": {"total": usage.total, "free": usage.free},
        "gpus": gpus(),
        "device": dmi or "This computer",
        "hostname": socket.gethostname(),
        "uptime": float(read("/proc/uptime", "0 0").split()[0]),
        "live": is_live(),
        "persistent": persistent(),
        "timezone": timezone(),
        "battery": battery(),
        "software": SOFTWARE,
        "debug": DEBUG,
        "open": cmdline_value("nimbus.open"),  # app[:page] to open at startup
        "test": os.environ.get("NIMBUS_TEST") or cmdline_value("nimbus.test"),  # boot tests (os/test-boot.sh)
        "wm": bool(os.environ.get("NIMBUS_WM_FD")),  # programs' windows show on the desktop
        "arch": platform_machine(),
        "uefi": os.path.isdir("/sys/firmware/efi"),
        "built": BUILD.get("date"),
        "build": (BUILD.get("commit") or "")[:7],
        "machineId": read("/etc/machine-id")[:12],
        "touch": any("ID_INPUT_TOUCHSCREEN=1" in read(p) for p in glob.glob("/run/udev/data/c13:*")),
    }


def program_env():
    """The environment programs started from the desktop get."""
    env = {k: v for k, v in os.environ.items() if k not in PRIVATE_ENV}
    env.setdefault("XDG_SESSION_TYPE", "wayland")
    cursor = nimbus_sys.load_json(os.path.join(nimbus_sys.CONFIG_DIR, "cursor.json"), {})
    if cursor.get("theme"):  # Settings > Accessibility > Mouse pointer
        env["XCURSOR_THEME"], env["XCURSOR_SIZE"] = cursor["theme"], str(cursor.get("size") or 24)
    return env


def proxy_flags():
    """Settings > Network & internet > Proxy, for Chrome"""
    p = nimbus_sys.load_json(os.path.join(nimbus_sys.CONFIG_DIR, "proxy.json"), {})
    if p.get("manual") and p.get("host") and str(p.get("port", "")).isdigit():
        bypass = [x.strip() for x in re.split(r"[;,\s]+", p.get("bypass") or "") if x.strip()] + (["<local>"] if p.get("local") else [])
        return ["--proxy-server=%s:%s" % (p["host"], p["port"])] + (["--proxy-bypass-list=" + ";".join(bypass)] if bypass else [])
    if p.get("pacOn") and p.get("pac"):
        return ["--proxy-pac-url=" + p["pac"]]
    if p.get("auto"):
        return ["--proxy-auto-detect"]
    return []


def spawn(argv):
    """Start a program on its own (it outlives this process); its output goes to a log file."""
    log = open(os.path.join(CACHE_DIR, "programs.log"), "ab")
    proc = subprocess.Popen(argv, env=program_env(), stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                            start_new_session=True, close_fds=True, cwd=os.path.expanduser("~"))
    log.close()
    GLib.child_watch_add(GLib.PRIORITY_DEFAULT, proc.pid, lambda *_: None)  # collect it when it exits
    return proc.pid


def image_data_url(path, limit=600 * 1024):
    try:
        if not path or os.path.getsize(path) > limit:
            return None
        with open(path, "rb") as f:
            data = f.read()
    except OSError:
        return None
    kind = "image/svg+xml" if path.endswith(".svg") else "image/png" if path.endswith(".png") else None
    return "data:%s;base64,%s" % (kind, base64.b64encode(data).decode()) if kind else None


def chrome_status():
    if not os.access(CHROME, os.X_OK):
        return {"installed": False, "version": None, "icon": None}
    version = ""
    try:
        r = subprocess.run(["dpkg-query", "-W", "-f=${Version}", "google-chrome-stable"], capture_output=True, text=True, timeout=10)
        version = r.stdout.strip().split("-")[0]
    except (OSError, subprocess.TimeoutExpired):
        pass
    icon = next((image_data_url(p) for p in CHROME_ICONS if os.path.exists(p)), None)
    return {"installed": True, "version": version, "icon": icon}


def desktop_entry(app_id):
    """Name and icon of a program, from its .desktop file (matched by file name or StartupWMClass)."""
    dirs = [os.path.join(d, "applications") for d in [GLib.get_user_data_dir()] + list(GLib.get_system_data_dirs())]
    files = [os.path.join(d, app_id + ".desktop") for d in dirs] + [f for d in dirs for f in sorted(glob.glob(os.path.join(d, "*.desktop")))]
    for path in files:
        if not os.path.isfile(path):
            continue
        cp = configparser.RawConfigParser(strict=False, interpolation=None)
        try:
            cp.read(path, encoding="utf-8")
            entry = cp["Desktop Entry"]
        except (configparser.Error, KeyError, UnicodeDecodeError):
            continue
        base = os.path.basename(path)[:-len(".desktop")]
        if base != app_id and entry.get("StartupWMClass", "").lower() != app_id.lower():
            continue
        return {"name": entry.get("Name", ""), "icon": icon_url(entry.get("Icon", ""))}
    return None


def icon_url(name):
    if not name:
        return None
    if name.startswith("/"):
        return image_data_url(name)
    for size in ("256x256", "128x128", "96x96", "64x64", "48x48", "scalable"):
        for ext in ("png", "svg"):
            for theme in ("hicolor", "Adwaita"):
                path = "/usr/share/icons/%s/%s/apps/%s.%s" % (theme, size, name, ext)
                if os.path.exists(path):
                    return image_data_url(path)
    for ext in ("png", "svg"):
        if os.path.exists("/usr/share/pixmaps/%s.%s" % (name, ext)):
            return image_data_url("/usr/share/pixmaps/%s.%s" % (name, ext))
    return None


class WMLink:
    """The connection to nimbus-wm: JSON events in, one-line commands out (see wm/nimbus-wm.c)."""

    def __init__(self, fd, on_event):
        self.sock = socket.socket(fileno=fd)
        self.sock.setblocking(False)
        self.inbuf = b""
        self.outbuf = b""
        self.out_watch = None
        self.on_event = on_event
        GLib.io_add_watch(fd, GLib.PRIORITY_HIGH, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.on_readable)

    def on_readable(self, _fd, _cond):
        try:
            data = self.sock.recv(65536)
        except BlockingIOError:
            return True
        except OSError:
            data = b""
        if not data:
            print("nimbus-shell: the window manager went away", file=sys.stderr)
            Gtk.main_quit()
            return False
        self.inbuf += data
        while b"\n" in self.inbuf:
            line, self.inbuf = self.inbuf.split(b"\n", 1)
            try:
                event = json.loads(line.decode("utf-8", "replace"))
            except ValueError:
                continue
            self.on_event(event)
        return True

    def send(self, line):
        self.outbuf += line.encode() + b"\n"
        self.flush()

    def flush(self, *_):
        while self.outbuf:
            try:
                n = self.sock.send(self.outbuf)
            except BlockingIOError:
                break
            except OSError:
                self.outbuf = b""
                break
            self.outbuf = self.outbuf[n:]
        if self.outbuf and not self.out_watch:
            def writable(*_):
                self.out_watch = None
                self.flush()
                return False
            self.out_watch = GLib.io_add_watch(self.sock.fileno(), GLib.PRIORITY_HIGH, GLib.IO_OUT, writable)
        return False


class Shell(nimbus_sys.SysMethods):
    def __init__(self):
        os.makedirs(DATA_DIR, exist_ok=True)
        os.makedirs(CACHE_DIR, exist_ok=True)
        manager = WebKit2.WebsiteDataManager(base_data_directory=os.path.join(DATA_DIR, "web"),
                                             base_cache_directory=os.path.join(CACHE_DIR, "web"))
        context = WebKit2.WebContext.new_with_website_data_manager(manager)
        context.set_cache_model(WebKit2.CacheModel.DOCUMENT_VIEWER)
        content = WebKit2.UserContentManager()
        content.connect("script-message-received::nimbus", self.on_message)
        try:
            content.register_script_message_handler("nimbus")
        except TypeError:  # newer API takes a script world name too
            content.register_script_message_handler("nimbus", None)
        self.view = WebKit2.WebView(web_context=context, user_content_manager=content)
        s = self.view.get_settings()
        for key, value in (("enable-developer-extras", bool(os.environ.get("NIMBUS_DEBUG"))),
                           ("allow-file-access-from-file-urls", True),
                           ("allow-universal-access-from-file-urls", True),
                           ("enable-write-console-messages-to-stdout", True),
                           ("javascript-can-access-clipboard", True),
                           ("enable-back-forward-navigation-gestures", False),
                           ("enable-page-cache", False),
                           ("enable-smooth-scrolling", True)):
            try:
                s.set_property(key, value)
            except TypeError:
                pass
        try:
            s.set_property("hardware-acceleration-policy",
                           WebKit2.HardwareAccelerationPolicy.NEVER if SOFTWARE else WebKit2.HardwareAccelerationPolicy.ALWAYS)
        except Exception:
            pass
        self.view.set_background_color(Gdk.RGBA(0, 0, 0, 1))
        self.view.connect("context-menu", self.on_context_menu)
        self.view.connect("decide-policy", self.on_policy)
        self.view.connect("web-process-terminated", self.on_crash)
        self.window = Gtk.Window(title="Nimbus")
        self.window.set_default_size(1280, 800)
        self.window.add(self.view)
        self.window.connect("destroy", self.on_destroy)
        self.terminals = nimbus_term.Terminals(
            emit=self.emit,
            watch=lambda fd, callback: GLib.io_add_watch(fd, GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
                                                         lambda *_: callback()),
            unwatch=GLib.source_remove,
            later=lambda ms, fn: GLib.timeout_add(ms, lambda: fn() and False))
        if DEBUG:
            for name in ("key-press-event", "key-release-event"):
                self.window.connect(name, self.debug_key)
            for widget, label in ((self.window, "window"), (self.view, "page")):
                widget.connect("focus-in-event", lambda *_a, l=label: print("nimbus-shell: focus in:", l) and False)
                widget.connect("focus-out-event", lambda *_a, l=label: print("nimbus-shell: focus out:", l) and False)
        self.window.show_all()
        self.window.fullscreen()
        self.view.grab_focus()  # keys go to the desktop from the first press
        uri = GLib.filename_to_uri(os.path.join(SHELL_DIR, "index.html"), None)
        self.view.load_uri(uri + ("?debug=1" if DEBUG else ""))
        self.net_due = False
        self.watch_network()
        # Programs' windows: what the window manager has told us, so a page that (re)loads can catch up
        self.windows = {}
        self.page_ready = False
        self.focused = None
        self.wm = WMLink(int(os.environ["NIMBUS_WM_FD"]), self.on_wm_event) if os.environ.get("NIMBUS_WM_FD") else None
        self.sys_init()
        self.listen_for_links()
        if self.wm and os.access(CHROME, os.X_OK):
            GLib.timeout_add_seconds(90, self.update_chrome)

    def debug_key(self, window, event):
        focus = window.get_focus()
        print("nimbus-shell: %s %s (focus: %s, active: %s)" % (
            "down" if event.type == Gdk.EventType.KEY_PRESS else "up", Gdk.keyval_name(event.keyval),
            type(focus).__name__ if focus else None, window.is_active()))
        return False

    # ---- page <-> machine ----
    def on_message(self, _manager, value):
        try:
            if hasattr(value, "get_js_value"):  # WebKitGTK before 2.40
                value = value.get_js_value()
            msg = json.loads(value.to_string())
            mid, method, args = int(msg["id"]), str(msg["method"]), msg.get("args") or {}
        except Exception as exc:  # malformed message: nothing to answer
            print("nimbus-shell: bad message:", exc, file=sys.stderr)
            return
        handler = getattr(self, "m_" + method, None)
        if not handler:
            self.reply(mid, False, "Unknown method: " + method)
            return
        if method in MAIN_THREAD:
            try:
                self.reply(mid, True, handler(args))
            except Exception as exc:
                self.reply(mid, False, str(exc))
            return

        def run():
            try:
                result = handler(args)
                GLib.idle_add(self.reply, mid, True, result)
            except Exception as exc:
                GLib.idle_add(self.reply, mid, False, str(exc))
        threading.Thread(target=run, daemon=True).start()

    def reply(self, mid, ok, data):
        script = "window.__nimbusNative && window.__nimbusNative.%s(%d, %s);" % ("resolve" if ok else "reject", mid, json.dumps(data))
        self.run_js(script)
        return False

    def run_js(self, script):
        # The JavaScript entry point differs between WebKitGTK releases; use whichever this one has.
        view = self.view
        attempts = (
            lambda: view.evaluate_javascript(script, -1, None, None, None, None),
            lambda: view.evaluate_javascript(script, -1, None, None, None, None, None),
            lambda: view.run_javascript(script, None, None),
            lambda: view.run_javascript(script, None, None, None),
        )
        for attempt in attempts:
            try:
                attempt()
                return
            except (TypeError, AttributeError):
                continue
        print("nimbus-shell: could not reply to the page", file=sys.stderr)

    def emit(self, name, data):
        """Send an event to the page (it arrives on the page's bus as 'native:<name>')."""
        self.run_js("window.__nimbusNative && window.__nimbusNative.event(%s, %s);" % (json.dumps(name), json.dumps(data)))

    # ---- programs' windows (nimbus-wm) ----
    def on_wm_event(self, event):
        kind, wid = event.get("ev"), event.get("id")
        if kind == "outputs":
            self.on_outputs(event)
            return
        if kind == "inputs":
            self.on_inputs(event)
            return
        if kind == "idle":
            if self.page_ready:
                self.emit("idle", event)
            return
        if kind == "new":
            self.windows[wid] = dict(event)
        elif kind == "gone":
            self.windows.pop(wid, None)
        elif wid in self.windows and kind in ("title", "app", "geom", "parent", "deco"):
            self.windows[wid].update({k: v for k, v in event.items() if k not in ("ev", "id")})
        if kind == "focus":
            self.focused = wid
        if self.page_ready:
            self.emit("wm", event)

    def m_wmReady(self, _args):
        """The page is listening: tell it about the windows that are already open."""
        self.page_ready = True
        for event in list(self.windows.values()):
            self.emit("wm", dict(event, ev="new"))
        if self.focused:
            self.emit("wm", {"ev": "focus", "id": self.focused})
        return len(self.windows)

    def m_wm(self, args):
        if not self.wm:
            raise RuntimeError("No window manager")
        cmd = args.get("cmd")
        num = lambda v: str(int(round(float(v or 0))))  # noqa: E731
        rects = lambda rs: [str(len(rs))] + [num(x) for r in rs for x in (list(r) + [0] * 5)[:5]]  # noqa: E731
        if cmd == "layout":
            words = ["layout"] + rects(args.get("top") or [])
            stack = args.get("stack") or []
            words.append(str(len(stack)))
            for wid, above in stack:
                words += [num(wid)] + rects(above)
            self.wm.send(" ".join(words))
        elif cmd in ("focus", "close"):
            self.wm.send("%s %s" % (cmd, num(args.get("id"))))
        elif cmd == "show":
            self.wm.send("show %s %s" % (num(args.get("id")), num(args.get("on"))))
        elif cmd == "geom":
            self.wm.send("geom " + " ".join(num(args.get(k)) for k in ("id", "x", "y", "w", "h", "state", "rw", "rh")))
        elif cmd == "area":
            self.wm.send("area " + " ".join(num(args.get(k)) for k in ("x", "y", "w", "h")))
        elif cmd == "overlay":
            self.wm.send("overlay %s %s" % (num(args.get("dim")), num(args.get("night"))))
        elif cmd == "input":
            keys = ("speed", "accel", "left", "scroll", "natural", "tap", "tap2", "twofinger", "tnatural", "dwt", "tspeed", "touchpad")
            self.wm.send("input " + " ".join(num(args.get(k)) for k in keys))
        elif cmd == "keymap":
            layout, variant = str(args.get("layout") or "us"), str(args.get("variant") or "")
            if not re.match(r"^[a-z]{2,8}$", layout) or not re.match(r"^[A-Za-z0-9_-]{0,32}$", variant):
                raise ValueError("Unknown keyboard layout")
            self.wm.send("keymap %s %s %s %s" % (layout, variant or "-", num(args.get("delay") or 500), num(args.get("rate") or 30)))
        elif cmd == "cursor":
            theme = "DMZ-Black" if args.get("theme") == "black" else "DMZ-White"
            if not os.path.isdir("/usr/share/icons/" + theme):
                theme = "default"
            self.wm.send("cursor %s %s" % (theme, num(args.get("size") or 24)))
        elif cmd == "idle":
            self.wm.send("idle %s %s" % (num(args.get("screen")), num(args.get("sleep"))))
        elif cmd == "paste":
            self.wm.send("paste")
        elif cmd == "grab":  # the title bar or an edge Nimbus draws around an X11 program's window was dragged
            self.wm.send("grab %s %s" % (num(args.get("id")), num(int(args.get("edges") or 0) & 15)))
        else:
            raise ValueError("Unknown window manager command")
        return True

    # ---- programs: Google Chrome, installed from Google (see /usr/lib/nimbus/nimbus-apps) ----
    def m_appStatus(self, _args):
        return {"chrome": chrome_status()}

    def m_appInfo(self, args):
        app_id = str(args.get("appId", ""))
        if not re.match(r"^[A-Za-z0-9._-]{1,200}$", app_id):
            return None
        return desktop_entry(app_id)

    def m_appLaunch(self, args):
        if args.get("app") != "chrome":
            raise ValueError("Unknown program")
        if not os.access(CHROME, os.X_OK):
            raise RuntimeError("Google Chrome isn't installed")
        argv = [CHROME, "--ozone-platform=wayland", "--no-default-browser-check", "--password-store=basic", "--enable-features=TouchpadOverscrollHistoryNavigation"] + proxy_flags()
        if args.get("test"):
            argv.append("--no-first-run")
        url = str(args.get("url") or "")
        if url and re.match(r"^(https?|file|data):", url, re.I):
            argv.append(url)
        return spawn(argv)

    def m_appInstall(self, args):
        if args.get("app") != "chrome":
            raise ValueError("Unknown program")
        result = self.run_apps_helper("install", "chrome")
        self.record_update("Google Chrome %s" % result.get("version", ""), True, "installed")
        # Chrome is the browser for web links, and knows it
        subprocess.run(["xdg-settings", "set", "default-web-browser", "google-chrome.desktop"],
                       env=program_env(), capture_output=True, timeout=30)
        return result

    def run_apps_helper(self, *args, quiet=False):
        """Run the installer helper as root (allowed by /etc/sudoers.d/nimbus-apps), passing its progress to the page."""
        proc = subprocess.Popen(["sudo", "-n", "/usr/lib/nimbus/nimbus-apps", *args], stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True)
        last = {}
        for line in proc.stdout:
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            last = msg
            if "progress" in msg and not quiet:
                GLib.idle_add(lambda m=msg: self.emit("app-progress", m) and False)
        err = proc.stderr.read()
        proc.wait()
        if not last.get("ok"):
            raise RuntimeError(last.get("error") or (err.strip().splitlines() or ["Installing failed"])[-1])
        return last

    def update_chrome(self):
        """Once a while after startup, bring Chrome up to date (Chrome on Linux leaves that to the system)."""
        def run():
            try:
                prefs = nimbus_sys.load_json(os.path.join(nimbus_sys.CONFIG_DIR, "updates.json"), {})
                if prefs.get("auto") is False or (prefs.get("paused") or 0) > time.time() * 1000:
                    return  # Settings > Nimbus Update: paused, or programs don't update by themselves
                if nimbus_net.available() and nimbus_net.status().get("connectivity") == "none":
                    return
                if not prefs.get("metered") and "yes" in nimbus_sys.run(["nmcli", "-t", "-f", "GENERAL.METERED", "general"], check=False).lower():
                    return
                result = self.run_apps_helper("update", "chrome", quiet=True)
                if result.get("updated"):
                    self.record_update("Google Chrome %s" % result.get("version", ""), True)
                print("nimbus-shell: Chrome update:", result.get("text", "done"))
            except Exception as exc:
                print("nimbus-shell: Chrome update:", exc, file=sys.stderr)
        threading.Thread(target=run, daemon=True).start()
        return False

    def m_programUpdate(self, args):
        if args.get("app") != "chrome":
            raise ValueError("Unknown program")
        try:
            result = self.run_apps_helper("update", "chrome", quiet=True)
        except Exception as exc:
            self.record_update("Google Chrome", False, str(exc))
            raise
        self.record_update("Google Chrome %s" % result.get("version", ""), True)
        return result

    def m_programRemove(self, args):
        if args.get("app") != "chrome":
            raise ValueError("Unknown program")
        return self.run_apps_helper("remove", "chrome", quiet=True)

    def m_openUrl(self, args):
        """Open a web link: in Chrome, or the page offers to install it first."""
        self.emit("open-url", {"urls": [str(args.get("url", ""))]})
        return True

    def listen_for_links(self):
        """Web links opened by programs go to /usr/lib/nimbus/nimbus-open, which runs Chrome when it's installed
        and otherwise asks the desktop (through this socket) to offer installing it."""
        path = os.path.join(GLib.get_user_runtime_dir(), "nimbus-shell.sock")
        try:
            if os.path.exists(path):
                os.unlink(path)
            self.links = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
            self.links.bind(path)
            os.chmod(path, 0o600)
        except OSError as exc:
            print("nimbus-shell: no link socket:", exc, file=sys.stderr)
            return

        def readable(*_):
            try:
                data = json.loads(self.links.recv(65536).decode("utf-8", "replace"))
                urls = [str(u) for u in data.get("open", []) if re.match(r"^(https?|file):", str(u), re.I)][:10]
                if urls:
                    self.emit("open-url", {"urls": urls})
            except (OSError, ValueError, AttributeError):
                pass
            return True
        GLib.io_add_watch(self.links.fileno(), GLib.PRIORITY_DEFAULT, GLib.IO_IN, readable)

    def on_destroy(self, *_):
        self.terminals.close_all()
        Gtk.main_quit()

    # ---- terminals (bash in a pseudo-terminal, see nimbus_term.py) ----
    def m_termOpen(self, args):
        return self.terminals.open(args.get("cols", 80), args.get("rows", 24))

    def m_termInput(self, args):
        return self.terminals.input(args.get("id"), args.get("data", ""))

    def m_termResize(self, args):
        return self.terminals.resize(args.get("id"), args.get("cols"), args.get("rows"))

    def m_termClose(self, args):
        return self.terminals.close(args.get("id"))

    # ---- network (NetworkManager, see nimbus_net.py) ----
    def m_netStatus(self, _args):
        return nimbus_net.status()

    def m_wifiList(self, args):
        return nimbus_net.networks(rescan=bool(args.get("rescan")))

    def m_wifiConnect(self, args):
        return nimbus_net.connect(args.get("ssid", ""), args.get("password") or None, bool(args.get("hidden")))

    def m_wifiDisconnect(self, _args):
        return nimbus_net.disconnect()

    def m_wifiForget(self, args):
        return nimbus_net.forget(args.get("ssid", ""))

    def m_wifiRadio(self, args):
        return nimbus_net.set_wifi(bool(args.get("on")))

    def m_airplane(self, args):
        return nimbus_net.set_airplane(bool(args.get("on")))

    def watch_network(self):
        """Follow `nmcli monitor` and tell the page when the network changes."""
        if not nimbus_net.available():
            return
        try:
            self.net_monitor = subprocess.Popen(["nmcli", "monitor"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                                env=dict(os.environ, LC_ALL="C"))
        except OSError:
            return
        GLib.io_add_watch(self.net_monitor.stdout.fileno(), GLib.PRIORITY_DEFAULT_IDLE, GLib.IO_IN | GLib.IO_HUP,
                          self.on_network_change)

    def on_network_change(self, fd, condition):
        try:
            data = os.read(fd, 4096)
        except OSError:
            data = b""
        if not data:  # the monitor stopped (NetworkManager restarting): try again shortly
            GLib.timeout_add_seconds(5, lambda: self.watch_network() and False)
            return False
        if not self.net_due:
            self.net_due = True
            GLib.timeout_add(400, self.send_network_status)
        return True

    def send_network_status(self):
        self.net_due = False

        def run():
            try:
                data = nimbus_net.status()
            except Exception as exc:  # report nothing rather than break the page
                print("nimbus-shell: network status:", exc, file=sys.stderr)
                return
            GLib.idle_add(lambda: self.emit("net", data) and False)
        threading.Thread(target=run, daemon=True).start()
        return False

    # ---- saving between restarts (see /usr/lib/nimbus/nimbus-storage) ----
    def m_storageStatus(self, _args):
        return storage("status")

    def m_storageSetup(self, args):
        place = str(args.get("id", ""))
        if not re.match(r"^(free|empty):[a-z0-9]+$", place):
            raise ValueError("Unknown place to save")
        return storage("setup", place)

    def m_info(self, _args):
        return info()

    def m_battery(self, _args):
        return battery()

    def m_timezones(self, _args):
        return timezones()

    def m_setTimezone(self, args):
        tz = str(args.get("tz", ""))
        if tz not in timezones():
            raise ValueError("Unknown time zone")
        subprocess.run(["timedatectl", "set-timezone", tz], check=True, timeout=15, capture_output=True)
        # The page's clock reads the zone when it starts, so start a fresh page.
        GLib.timeout_add(400, self.restart)
        return tz

    def m_power(self, args):
        action = args.get("action")
        cmd = {"poweroff": ["systemctl", "poweroff"], "reboot": ["systemctl", "reboot"], "suspend": ["systemctl", "suspend"]}.get(action)
        if not cmd:
            raise ValueError("Unknown power action")
        r = subprocess.run(cmd, timeout=20, capture_output=True, text=True)
        if r.returncode != 0:
            raise RuntimeError((r.stderr or r.stdout or "The system refused").strip())
        return action

    def m_log(self, args):
        print("page:", str(args.get("text", ""))[:500])
        return True

    def restart(self):
        self.terminals.close_all()
        if self.wm:
            os._exit(75)  # the window manager starts the desktop again; programs keep running
        os.execv(sys.executable, [sys.executable] + sys.argv)

    # ---- guard rails ----
    def on_context_menu(self, _view, _menu, _event, hit):
        return not hit.context_is_editable()  # keep cut/copy/paste in text fields only

    def on_policy(self, _view, decision, kind):
        if kind == WebKit2.PolicyDecisionType.NAVIGATION_ACTION:
            uri = decision.get_navigation_action().get_request().get_uri()
            if not uri.startswith("file://" + SHELL_DIR) and not uri.startswith("about:"):
                decision.ignore()
                if re.match(r"^https?:", uri, re.I):
                    self.emit("open-url", {"urls": [uri]})  # web links open in the browser
                return True
        if kind == WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION:
            uri = decision.get_navigation_action().get_request().get_uri()
            decision.ignore()
            if re.match(r"^https?:", uri or "", re.I):
                self.emit("open-url", {"urls": [uri]})
            return True
        return False

    def on_crash(self, view, _reason):
        print("nimbus-shell: page process stopped, reloading", file=sys.stderr)
        GLib.timeout_add(500, lambda: (view.reload(), False)[1])


def main():
    Shell()
    Gtk.main()


if __name__ == "__main__":
    main()
