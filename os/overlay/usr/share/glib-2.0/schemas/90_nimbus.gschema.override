# Programs that draw their own title bars (Google Chrome, GTK apps) put minimize, maximize and close
# on the right, as on Windows. The GNOME default shows only close.
[org.gnome.desktop.wm.preferences]
button-layout=':minimize,maximize,close'

# Windows 11's look in programs too: Selawik (Segoe UI's open-source stand-in) and white pointers
[org.gnome.desktop.interface]
font-name='Selawik 10'
document-font-name='Selawik 11'
cursor-theme='DMZ-White'
