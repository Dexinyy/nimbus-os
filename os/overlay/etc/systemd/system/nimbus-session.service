[Unit]
Description=Nimbus desktop
Documentation=file:///usr/share/doc/nimbus-os/README.md
After=systemd-user-sessions.service plymouth-quit-wait.service systemd-logind.service dbus.service getty@tty1.service
Wants=dbus.service systemd-logind.service
Conflicts=getty@tty1.service
# Always bring the desktop back, however often it stops
StartLimitIntervalSec=0

[Service]
Type=simple
User=nimbus
PAMName=nimbus-session
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user
ExecStart=/usr/bin/nimbus-session
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
Alias=display-manager.service
